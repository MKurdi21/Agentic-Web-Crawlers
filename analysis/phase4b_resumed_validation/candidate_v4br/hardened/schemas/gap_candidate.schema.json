{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litrev:v2:gap_candidate",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "identifier"
    },
    "synthesis_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "identifier"
      },
      "minItems": 1
    },
    "statement": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "novelty_status": {
      "const": "NOT_EXTERNALLY_VALIDATED"
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "synthesis_ids",
    "statement",
    "limitations",
    "novelty_status"
  ],
  "additionalProperties": false
}
