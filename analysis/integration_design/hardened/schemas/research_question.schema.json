{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litrev:v2:research_question",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "identifier"
    },
    "gap_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "identifier"
      },
      "minItems": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "testable_outcome": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "gap_ids",
    "question",
    "testable_outcome",
    "limitations"
  ],
  "additionalProperties": false
}
