{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:litrev:v2:research_object",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "record_id": {
      "type": "string",
      "minLength": 1,
      "format": "identifier"
    },
    "state": {
      "enum": [
        "CANDIDATE",
        "CONFIRMED",
        "REJECTED",
        "UNRESOLVED"
      ]
    },
    "members": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "identifier"
      },
      "minItems": 1
    },
    "relationship_type": {
      "enum": [
        "VERSION_OF",
        "SAME_CONTRIBUTION",
        "EXTENDS",
        "REPLICATES",
        "UNRESOLVED"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "format": "identifier"
      },
      "minItems": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "record_id",
    "state",
    "members",
    "relationship_type",
    "evidence_ids",
    "rationale"
  ],
  "additionalProperties": false
}
